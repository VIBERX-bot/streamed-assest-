<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CUE4PARSE_SKIP_NATIVE>true</CUE4PARSE_SKIP_NATIVE>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- Ignore dependencies and an accidentally nested copy of this project. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Dependencies\**;ShopStreamExtractor\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Dependencies\**\*.cs" />
    <Compile Remove="ShopStreamExtractor\**\*.cs" />
    <EmbeddedResource Remove="Dependencies\**\*" />
    <EmbeddedResource Remove="ShopStreamExtractor\**\*" />
    <None Remove="Dependencies\**\*" />
    <None Remove="ShopStreamExtractor\**\*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Dependencies\CUE4Parse\CUE4Parse\CUE4Parse.csproj" />
    <ProjectReference Include="Dependencies\CUE4Parse\CUE4Parse-Conversion\CUE4Parse-Conversion.csproj" />
    <PackageReference Include="EpicManifestParser" Version="3.0.0-preview.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
</Project>
